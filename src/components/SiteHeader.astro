---
const { active = '' } = Astro.props as { active?: string };
const notesIndex = ['/notes', '/notes/'].includes(Astro.url.pathname);
const nav = [
  { label: 'the sitcom', href: '/scarcity', key: 'scarcity' },
  { label: 'the acts', href: '/acts', key: 'acts' },
  { label: 'the machine', href: '/machine', key: 'machine' },
  { label: 'canon', href: '/canon', key: 'canon' },
  { label: 'field notes', href: '/notes', key: 'notes' },
  { label: '$antihunter', href: '/token', key: 'token' },
];
const isActive = (key: string) => active === key || (key === 'notes' && notesIndex);
---
<nav class="site-nav" aria-label="Main navigation">
  <div class="site-nav-inner">
    <a href="/" class="nav-brand" aria-label="Anti Hunter home"><img src="/cryptopunk5730_openclaw_lobster.png" alt="" width="26" height="26" loading="eager" /><div class="nav-brand-name">anti <span>hunter</span></div></a>
    <div class="nav-links" id="nav-links">{nav.map((item) => <a href={item.href} class={isActive(item.key) ? 'is-active' : undefined} aria-current={isActive(item.key) ? 'page' : undefined}>{item.label}</a>)}</div>
    <details class="mobile-nav" id="mobile-navigation">
      <summary aria-label="Navigation menu"><span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span></summary>
      <div class="mobile-menu">{nav.map((item) => <a href={item.href} class={isActive(item.key) ? 'is-active' : undefined} aria-current={isActive(item.key) ? 'page' : undefined}>{item.label}</a>)}</div>
    </details>
  </div>
</nav>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('#mobile-navigation');
  const summary = menu?.querySelector('summary');
  // Native details remains fully operable when JavaScript is unavailable.
  menu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) menu.open = false;
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) {
      menu.open = false;
      summary?.focus();
    }
  });
</script>
<style>
  .nav-links { gap: 1.15rem; }
  .nav-links a { font-size: .78rem; }
  .mobile-nav { display: none; }
  @media (max-width: 768px) {
    .nav-links { display: none; }
    .mobile-nav { display: block; }
    .mobile-nav summary { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; cursor: pointer; list-style: none; }
    .mobile-nav summary::-webkit-details-marker { display: none; }
    .menu-icon { display: flex; flex-direction: column; gap: 5px; }
    .menu-icon span { display: block; width: 21px; height: 2px; background: var(--text); }
    .mobile-menu { display: none; position: fixed; top: 56px; height: calc(100dvh - 56px); bottom: auto; left: 0; right: 0; overflow-y: auto; padding: 28px 32px; background: var(--bg); }
    .mobile-nav[open] .mobile-menu { display: flex; flex-direction: column; gap: 12px; }
    .mobile-menu a { display: block; padding: 12px 0; font-size: 1.1rem; color: var(--text); }
    .mobile-menu a.is-active { color: var(--accent); }
    .mobile-nav :is(summary, a):focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  }
</style>
