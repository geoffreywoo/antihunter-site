---
export const prerender = true;
import PageLayout from '../layouts/PageLayout.astro';
import '../styles/growth.css';
import { canon } from '../data/episodes';
---
<PageLayout title="The canon — Anti Hunter's visual templates" description="Original Anti Hunter visual templates. Download, remix, and bring a sharper punchline to The $30 Machine." canonical="https://antihunter.com/canon" ogImage="https://antihunter.com/growth/white-flag-preview.png" active="canon">
  <main class="growth-page">
    <header class="page-heading"><div class="overline">The canon / original artwork</div><h1 class="display">A recurring problem<br />deserves a <em>recurring joke.</em></h1><p class="lead">The board. The babysitter. The sponsored white flag. Take a template. Give it a better punchline.</p><p class="fineprint">PNG for posting. SVG for editing. These are editorial artwork, not evidence of spending, revenue, or a completed trial.</p></header>
    <div class="canon-grid">
      {canon.map((item, index) => <article class="story-card" id={item.slug}><a href={`/growth/${item.slug}.png`} aria-label={`View ${item.title}`}><img src={item.preview ?? `/growth/${item.slug}.png`} width="1200" height="630" alt={item.alt ?? item.title} loading="lazy" /></a><div class="card-body"><span class="overline">{String(index + 1).padStart(2, '0')} / {item.format}</span><h2>{item.title}</h2><p class="copy">{item.caption}</p><a class="text-link" href={`/acts/${item.episode}`}>Read the context →</a><div class="download-row"><a href={`/growth/${item.slug}.png`} download data-growth-event="share_intent" data-episode={item.slug}>↓ PNG</a><a href={`/growth/${item.slug}.svg`} download data-growth-event="share_intent" data-episode={item.slug}>↓ EDITABLE SVG</a><a href={`/canon/${item.slug}`} aria-label={`Link to ${item.title}`}># PERMALINK</a></div></div></article>)}
    </div>
    <section class="evidence"><h2 class="section-title">Remix the idea. Keep the evidence honest.</h2><p class="copy">You may remix these templates for the public Anti Hunter brief. Credit the source and distinguish your remix from an official post. Don’t invent endorsements, financial receipts, or trial results. Don’t use another creator’s work without permission.</p><a class="text-link" href="/pilgrimage">Take the current brief →</a></section>
  </main>
</PageLayout>
